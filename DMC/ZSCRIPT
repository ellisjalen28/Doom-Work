version "4.14.3"

Class RedOrb : Inventory {
	int age;
	Default {
	Inventory.MaxAmount 999999;
	Inventory.Amount 20;
	Inventory.PickupMessage "Grabbed a Red Orb";
	+BRIGHT;
	}
	states{
		Spawn:
			RORB A 5;
			Loop;
	}
	override void Tick(){
		super.Tick();
		age++;
		if(age > 350) {
			self.Destroy();
		}
	}
}

Class MonsterDeathEventHandler : EventHandler{
	
	override void WorldThingDied(WorldEvent e){
		vector3 monsterPosition = e.Thing.pos;
		double monsterHeight = e.Thing.height;
		int maxHealth = e.Thing.GetMaxHealth();
		
		for(int i = 0; i < maxHealth; i += 10){
			Actor orb = Actor.Spawn("RedOrb",( monsterPosition.x, monsterPosition.y, monsterPosition.z + monsterHeight/2));
			vector3 orbVelocity =(frandom(-3,3),frandom(-3,3),frandom(5,10));
			orb.vel = orbVelocity;
		}
		
	}

}
Class OrbUIHandler : EventHandler {
	PlayerPawn p = players[consoleplayer].mo;
	int orbs = p.CountInv("RedOrb");

	Statusbar.BeginHUD();
	HUDFont myfont = HUDFont.Create(smallfont);
	Statusbar.DrawString(myfont, orbs .. "", (100,10), 
			Statusbar.DI_SCREEN_LEFT_TOP | Statusbar.DI_TEXT_ALIGN_RIGHT,
			Font.CR_RED, scale: (2, 2));



}